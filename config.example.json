{
  "host": "0.0.0.0",
  "port": 8090,
  "timeout": 30000,
  "max_request_body_bytes": 31457280,
  "default_stream": true,
  "auth_key": "",
  "log_level": 1,
  "ssl_cert": "",
  "ssl_key": "",
  "allowed_ips": [],
  "denied_ips": [
    "192.168.5.1"
  ],
  "models": [
    {
      "name": "deepseek-pro",
      "model_id": "deepseek-pro",
      "base_url": "https://genaiapi.shanghaitech.edu.cn/api/v1/start",
      "api_key": "YOUR_KEY",
      "upstream_model": "deepseek-pro",
      "api_format": "chat_completions",
      "supports_image": true,
      "supports_audio": false,
      "supports_video": false,
      "max_context_tokens": "500000"
    },
    {
      "name": "glm-chat",
      "model_id": "glm-chat",
      "base_url": "https://genaiapi.shanghaitech.edu.cn/api/v1/start",
      "api_key": "YOUR_KEY",
      "upstream_model": "glm-chat",
      "api_format": "chat_completions",
      "supports_image": true,
      "supports_audio": false,
      "supports_video": false,
      "max_context_tokens": "500000"
    },
    {
      "name": "minimax3-response",
      "model_id": "MiniMax-M3",
      "base_url": "https://api.minimax.cn",
      "api_key": "YOUR_KEY",
      "max_context_tokens": "500000"
    },
    {
      "name": "minimax3-claude",
      "model_id": "MiniMax-M3",
      "base_url": "https://api.minimaxi.com/anthropic",
      "api_key": "YOUR_KEY",
      "max_context_tokens": "500000"
    }
  ],
  "plugin_dir": "/opt/SHTUProxy/plugins",
  "plugins": [
    {
      "module": "comfy_workflow.py",
      "enabled": true,
      "timeout": 600,
      "options": {
        "comfy_url": "http://127.0.0.1:8188",
        "workflows_dir": "/path/to/comfy/workflows",
        "data_root": "/path/to/comfy-workflow-data",
        "comfy_output_root": "/path/to/comfy/output",
        "prompt_max": 8000,
        "upload_max_mb": 50,
        "max_wait": 600,
        "comfy_input_dir": "/path/to/comfy/input",
        "workflow_max_kb": 256,
        "workflow_max_nodes": 200,
        "output_retention_hours": 24,
        "output_max_files": 200,
        "cleanup_interval_s": 300
      }
    }
  ]
}
